# HTTP
PORT=3000
NODE_ENV=production
TZ=Asia/Shanghai

# SQLite
DB_PATH=data/sync.db

# Sync engine
SYNC_CONCURRENCY=4
SYNC_SCAN_INTERVAL_MS=5000
SYNC_DEFAULT_MAX_ATTEMPTS=5
SYNC_BACKOFF_BASE_MS=1000
SYNC_BACKOFF_FACTOR=2
SYNC_BACKOFF_MAX_MS=300000

# Transform worker threads (0 = main thread)
TRANSFORM_WORKERS=2

# Connectors
HTTP_CONNECTOR_TIMEOUT_MS=15000

# Logging: debug | info | warn | error
LOG_LEVEL=info
